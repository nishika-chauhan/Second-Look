FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libosmesa6 \
    libglu1-mesa \
    libxcb1 \
    libx11-6 \
    libxext6 \
    libsm6 \
    libxrender1 \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

ENV MUJOCO_GL=osmesa \
    PYOPENGL_PLATFORM=osmesa \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements-runtime.txt .

RUN pip --timeout 300 --retries 5 install --no-cache-dir -r requirements-runtime.txt

COPY . .

